{
  "name": "antigravity-chat-organizer",
  "displayName": "Antigravity Chat Organizer",
  "description": "Organize, rename, pin, categorize into folders, drag-and-drop, export, and search agent chat conversations in Google Antigravity IDE.",
  "version": "0.2.4",
  "publisher": "alexandrmotologa",
  "repository": {
    "type": "git",
    "url": "https://github.com/alexandrmotologa/antigravity-chat-organizer.git"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Productivity"
  ],
  "keywords": [
    "antigravity",
    "chat",
    "history",
    "organizer",
    "cascade",
    "gemini",
    "pins",
    "folders",
    "export"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "antigravity-chat-organizer",
          "title": "Chat Organizer",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "antigravity-chat-organizer": [
        {
          "id": "antigravity.chatOrganizerView",
          "name": "Agent Conversations"
        },
        {
          "id": "antigravity.artifactsView",
          "name": "Project Plans & Artifacts"
        }
      ]
    },
    "commands": [
      {
        "command": "antigravityChatOrganizer.refresh",
        "title": "Refresh Chats",
        "icon": "$(refresh)"
      },
      {
        "command": "antigravityChatOrganizer.searchChats",
        "title": "Quick Search Titles & Prompts",
        "icon": "$(search)"
      },
      {
        "command": "antigravityChatOrganizer.deepSearch",
        "title": "Deep Full-Text Search in Transcripts...",
        "icon": "$(search-fuzzy)"
      },
      {
        "command": "antigravityChatOrganizer.toggleWorkspaceFilter",
        "title": "Filter: Current Workspace Only",
        "icon": "$(filter)"
      },
      {
        "command": "antigravityChatOrganizer.createFolder",
        "title": "New Folder...",
        "icon": "$(new-folder)"
      },
      {
        "command": "antigravityChatOrganizer.focusChat",
        "title": "Open Chat in Cascade"
      },
      {
        "command": "antigravityChatOrganizer.renameChat",
        "title": "Rename Chat...",
        "icon": "$(edit)"
      },
      {
        "command": "antigravityChatOrganizer.togglePin",
        "title": "Pin / Unpin Chat",
        "icon": "$(pin)"
      },
      {
        "command": "antigravityChatOrganizer.moveToFolder",
        "title": "Move to Folder...",
        "icon": "$(folder)"
      },
      {
        "command": "antigravityChatOrganizer.removeFromFolder",
        "title": "Remove from Folder",
        "icon": "$(close)"
      },
      {
        "command": "antigravityChatOrganizer.setFolderIcon",
        "title": "Set Folder Emoji / Icon...",
        "icon": "$(symbol-color)"
      },
      {
        "command": "antigravityChatOrganizer.addNote",
        "title": "Add / Edit Note...",
        "icon": "$(note)"
      },
      {
        "command": "antigravityChatOrganizer.viewMarkdown",
        "title": "View Transcript (Markdown)",
        "icon": "$(markdown)"
      },
      {
        "command": "antigravityChatOrganizer.exportMarkdown",
        "title": "Export to Markdown Document",
        "icon": "$(export)"
      },
      {
        "command": "antigravityChatOrganizer.copyChatId",
        "title": "Copy Conversation ID",
        "icon": "$(copy)"
      },
      {
        "command": "antigravityChatOrganizer.openTranscript",
        "title": "Open Raw Transcript (JSONL)",
        "icon": "$(file-text)"
      },
      {
        "command": "antigravityChatOrganizer.openArtifact",
        "title": "Open Artifact"
      },
      {
        "command": "antigravityChatOrganizer.resumeInChat",
        "title": "Resume Context in Chat Panel",
        "icon": "$(play)"
      },
      {
        "command": "antigravityChatOrganizer.openWorkspace",
        "title": "Open Associated Workspace Folder",
        "icon": "$(folder-opened)"
      },
      {
        "command": "antigravityChatOrganizer.deleteFolder",
        "title": "Delete Folder",
        "icon": "$(trash)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "antigravityChatOrganizer.toggleWorkspaceFilter",
          "when": "view == antigravity.chatOrganizerView",
          "group": "navigation@1"
        },
        {
          "command": "antigravityChatOrganizer.deepSearch",
          "when": "view == antigravity.chatOrganizerView",
          "group": "navigation@2"
        },
        {
          "command": "antigravityChatOrganizer.searchChats",
          "when": "view == antigravity.chatOrganizerView",
          "group": "navigation@3"
        },
        {
          "command": "antigravityChatOrganizer.createFolder",
          "when": "view == antigravity.chatOrganizerView",
          "group": "navigation@4"
        },
        {
          "command": "antigravityChatOrganizer.refresh",
          "when": "view == antigravity.chatOrganizerView || view == antigravity.artifactsView",
          "group": "navigation@5"
        }
      ],
      "view/item/context": [
        {
          "command": "antigravityChatOrganizer.togglePin",
          "when": "view == antigravity.chatOrganizerView && viewItem == chatItem",
          "group": "inline@1"
        },
        {
          "command": "antigravityChatOrganizer.renameChat",
          "when": "view == antigravity.chatOrganizerView && viewItem == chatItem",
          "group": "inline@2"
        },
        {
          "command": "antigravityChatOrganizer.resumeInChat",
          "when": "view == antigravity.chatOrganizerView && viewItem == chatItem",
          "group": "1_actions@1"
        },
        {
          "command": "antigravityChatOrganizer.openWorkspace",
          "when": "view == antigravity.chatOrganizerView && viewItem == chatItem",
          "group": "1_actions@2"
        },
        {
          "command": "antigravityChatOrganizer.viewMarkdown",
          "when": "view == antigravity.chatOrganizerView && viewItem == chatItem",
          "group": "1_actions@3"
        },
        {
          "command": "antigravityChatOrganizer.exportMarkdown",
          "when": "view == antigravity.chatOrganizerView && viewItem == chatItem",
          "group": "1_actions@4"
        },
        {
          "command": "antigravityChatOrganizer.moveToFolder",
          "when": "view == antigravity.chatOrganizerView && viewItem == chatItem",
          "group": "1_actions@5"
        },
        {
          "command": "antigravityChatOrganizer.removeFromFolder",
          "when": "view == antigravity.chatOrganizerView && viewItem == chatItem",
          "group": "1_actions@6"
        },
        {
          "command": "antigravityChatOrganizer.addNote",
          "when": "view == antigravity.chatOrganizerView && viewItem == chatItem",
          "group": "1_actions@7"
        },
        {
          "command": "antigravityChatOrganizer.copyChatId",
          "when": "view == antigravity.chatOrganizerView && viewItem == chatItem",
          "group": "2_info@1"
        },
        {
          "command": "antigravityChatOrganizer.openTranscript",
          "when": "view == antigravity.chatOrganizerView && viewItem == chatItem",
          "group": "2_info@2"
        },
        {
          "command": "antigravityChatOrganizer.setFolderIcon",
          "when": "view == antigravity.chatOrganizerView && viewItem == folderItem",
          "group": "1_actions@1"
        },
        {
          "command": "antigravityChatOrganizer.deleteFolder",
          "when": "view == antigravity.chatOrganizerView && viewItem == folderItem",
          "group": "1_actions@2"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.x",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.4.5"
  }
}
